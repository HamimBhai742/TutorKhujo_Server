PORT=5026
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
PASSWORD_SALT=12
NODE_ENV="development"

# Docker Ports (for Docker Compose VPS Deployment)
SERVER_PORT=5026
CLIENT_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tutor_khujo


# JWT — Use strong random secrets in production (never reuse access and refresh secrets)
JWT_SECRET="your_strong_jwt_secret_here_min_32_chars"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your_strong_refresh_secret_here_different_from_jwt_secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password_here"
SMTP_FROM="TutorKhujo <your_email@gmail.com>"

# Admin Seed Credentials
ADMIN_EMAIL="admin@tutorkhujo.com"
ADMIN_PASSWORD="your_strong_admin_password_here"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id_here"

# Firebase (paste entire service account JSON as a single-line string)
# Get from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# AI Chatbot Configuration (TabiAI / NewAPI / OpenAI-compatible)
TABIAI_BASE_URL="https://api.tabiai.com/v1"
TABIAI_API_KEY="your_api_key_here"
TABIAI_MODEL="gpt-4o-mini"