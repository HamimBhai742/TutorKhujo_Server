{
	"info": {
		"_postman_id": "c1f77d33-4f9b-43d9-9528-761ab2f20a9a",
		"name": "TutorKhujo Auth API",
		"description": "Complete collection to test registration, OTP email verification, login, forgot password, and reset password flows for TutorKhujo.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth Flow",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Test Student\",\n    \"email\": \"student@example.com\",\n    \"password\": \"password123\",\n    \"mobile\": \"01712345678\",\n    \"role\": \"student\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Register a new user. Role can be either 'student' or 'tutor'. Check the backend console logs for the 6-digit OTP code."
					},
					"response": []
				},
				{
					"name": "Verify OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const responseJson = pm.response.json();",
									"if (responseJson.success && responseJson.data && responseJson.data.accessToken) {",
									"    pm.environment.set(\"token\", responseJson.data.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"student@example.com\",\n    \"otpCode\": \"123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/verify-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"verify-otp"
							]
						},
						"description": "Enter the 6-digit OTP code printed in the server logs. On successful verification, this enqueues the token and user data, auto-logging them in."
					},
					"response": []
				},
				{
					"name": "Resend OTP",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"student@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/resend-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"resend-otp"
							]
						},
						"description": "Trigger this endpoint to send a fresh 6-digit OTP code if the previous one expired."
					},
					"response": []
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const responseJson = pm.response.json();",
									"if (responseJson.success && responseJson.data && responseJson.data.accessToken) {",
									"    pm.environment.set(\"token\", responseJson.data.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"student@example.com\",\n    \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Log in with email and password. Accounts must be verified (isVerified: true) to successfully log in."
					},
					"response": []
				}
			]
		},
		{
			"name": "Password Recovery Flow",
			"item": [
				{
					"name": "Forgot Password",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"student@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/forgot-password",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"forgot-password"
							]
						},
						"description": "Trigger password recovery. Check server console logs for the 6-digit Reset OTP."
					},
					"response": []
				},
				{
					"name": "Verify Reset OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const responseJson = pm.response.json();",
									"if (responseJson.success && responseJson.data && responseJson.data.resetToken) {",
									"    pm.environment.set(\"reset_token\", responseJson.data.resetToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"student@example.com\",\n    \"otpCode\": \"987654\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/verify-reset-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"verify-reset-otp"
							]
						},
						"description": "Verify the reset OTP code. On success, this consumes the OTP and returns a single-use 'resetToken' (saved to environment)."
					},
					"response": []
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"student@example.com\",\n    \"resetToken\": \"{{reset_token}}\",\n    \"newPassword\": \"newPassword123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/reset-password",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"reset-password"
							]
						},
						"description": "Provide the 'resetToken' and the new password. This updates the user record and consumes the token."
					},
					"response": []
				}
			]
		},
		{
			"name": "User Profile (Protected)",
			"item": [
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/user/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"user",
								"me"
							]
						},
						"description": "Fetch the logged-in user profile. Requires the Bearer token returned from Login or Verify OTP."
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "paste_login_token_here",
			"type": "string"
		},
		{
			"key": "reset_token",
			"value": "paste_reset_token_here",
			"type": "string"
		}
	]
}
