generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String    @id @default(uuid())
  name                       String
  email                      String    @unique
  password                   String?
  mobile                     String?
  role                       Role      @default(student)
  status                     Status    @default(active)
  isVerified                 Boolean   @default(false)
  isFirstLogin               Boolean   @default(true)
  otpCode                    String?
  otpExpires                 DateTime?
  resetPasswordOtp           String?
  resetPasswordOtpExpires    DateTime?
  resetPasswordToken         String?
  resetPasswordTokenExpires  DateTime?
  tuitionPosts               TuitionPost[]
  applications               TuitionApplication[] @relation("TutorApplications")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model TuitionPost {
  id               String       @id @default(uuid())
  studentId        String
  student          User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title            String?
  classLevel       String
  subjects         String[]
  budget           Int
  mode             TuitionMode  @default(Home)
  frequency        String       @default("3 Days / Week")
  location         String
  status           PostStatus   @default(Active)
  genderPreference String?      @default("Any")
  extraNotes       String?
  applications     TuitionApplication[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([studentId])
  @@index([status])
}

model TuitionApplication {
  id             String            @id @default(uuid())
  tuitionPostId  String
  tuitionPost    TuitionPost       @relation(fields: [tuitionPostId], references: [id], onDelete: Cascade)
  tutorId        String
  tutor          User              @relation("TutorApplications", fields: [tutorId], references: [id], onDelete: Cascade)
  salaryBid      Int
  proposal       String?
  status         ApplicationStatus @default(Pending)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([tuitionPostId, tutorId])
  @@index([tuitionPostId])
  @@index([tutorId])
}

enum Status {
  active
  inactive
  blocked
}

enum Role {
  student
  tutor
  admin
}

enum TuitionMode {
  Home
  Online
  Both
}

enum PostStatus {
  Active
  Paused
  Closed
}

enum ApplicationStatus {
  Pending
  Shortlisted
  Hired
  Rejected
}
